# Base URL of the enphase-bridge Rust service.
ENPHASE_MCP_BRIDGE_URL=http://localhost:8080

# Optional: Bearer token sent as "Authorization: Bearer <key>" to the bridge.
# Leave unset if the bridge has no API key configured.
ENPHASE_MCP_BRIDGE_API_KEY=

# Host/port this MCP server binds to.
ENPHASE_MCP_HOST=127.0.0.1
ENPHASE_MCP_PORT=8000
