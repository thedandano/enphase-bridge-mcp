# Base URL of the enphase-bridge Rust service.
ENPHASE_MCP_BRIDGE_URL=http://localhost:8080

# Optional: Bearer token sent as "Authorization: Bearer <key>" to the bridge.
# Leave unset if the bridge has no API key configured.
ENPHASE_MCP_BRIDGE_API_KEY=

# Host/port this MCP server binds to.
ENPHASE_MCP_HOST=127.0.0.1
ENPHASE_MCP_PORT=8000

# Optional: comma-separated extra "Host" header values to accept, needed if
# ENPHASE_MCP_HOST above is bound to a non-loopback address (e.g. 0.0.0.0) so
# LAN clients can reach it. No wildcard fallback — only the hosts listed here
# are accepted. Leave unset to keep the default loopback-only behavior.
# ENPHASE_MCP_ALLOWED_HOSTS=192.168.1.50:8000,mydomain.local:8000
